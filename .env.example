# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:8080
API_PORT=4000
WEB_PORT=8080

# ---------------------------------------------------------------------------
# Database (Docker Compose creates this user/database)
# ---------------------------------------------------------------------------
POSTGRES_USER=ims
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=ims
# Inside Docker Compose the host is the service name "postgres".
# For running the API on the host, use localhost:5432 (compose.dev.yaml publishes it).
DATABASE_URL=postgresql://ims:change-me-in-production@postgres:5432/ims?schema=public
# Used only by the Vitest suite. Created by docker compose -f compose.yaml -f compose.dev.yaml up postgres
TEST_DATABASE_URL=postgresql://ims:change-me-in-production@localhost:5432/ims_test?schema=public

# ---------------------------------------------------------------------------
# Security (generate with: openssl rand -hex 48)
# ---------------------------------------------------------------------------
SESSION_SECRET=replace-with-a-long-random-value
COOKIE_SECURE=false
TRUST_PROXY=1
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Bootstrap (used only by `npm run create-super-admin` and the seed)
# Leave blank and run the command to enter credentials securely. There are no
# built-in default credentials.
# ---------------------------------------------------------------------------
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_NAME=Super Admin
SEED_DEMO_DATA=false
SEED_ON_START=false

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=5

# ---------------------------------------------------------------------------
# SMTP (password reset). Leave SMTP_HOST empty to log reset links in development.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# ---------------------------------------------------------------------------
# Cloudflare Tunnel (optional profile)
# ---------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=
