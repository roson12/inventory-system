generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum MovementType {
  OPENING
  RECEIPT
  ISSUE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  RETURN_IN
  RETURN_OUT
}

enum AdjustmentKind {
  INCREASE
  DECREASE
  SET
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum GoodsReceiptStatus {
  DRAFT
  CONFIRMED
}

enum CustomerOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_FOR_DISPATCH
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  LOW_STOCK
  ORDER_UPDATE
  APPROVAL
  PURCHASE_ORDER
  SYSTEM
}

// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String     @unique
  passwordHash       String
  name               String
  role               Role
  status             UserStatus @default(ACTIVE)
  phone              String?
  mustChangePassword Boolean    @default(false)
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  customer             Customer?
  passwordResetTokens  PasswordResetToken[]
  permissionOverrides  UserPermissionOverride[]
  warehouseAssignments UserWarehouseAssignment[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  customerOrders       CustomerOrder[]         @relation("CustomerOrders")
  processedOrders      CustomerOrder[]         @relation("ProcessedOrders")
  purchaseOrders       PurchaseOrder[]         @relation("PurchaseOrderCreator")
  approvedOrders       PurchaseOrder[]         @relation("PurchaseOrderApprover")
  goodsReceipts        GoodsReceipt[]
  adjustmentsRequested StockAdjustment[]       @relation("AdjustmentRequester")
  adjustmentsApproved  StockAdjustment[]       @relation("AdjustmentApprover")
  transfersRequested   StockTransfer[]         @relation("TransferRequester")
  transfersApproved    StockTransfer[]         @relation("TransferApprover")
  returnsRequested     Return[]                @relation("ReturnRequester")
  returnsProcessed     Return[]                @relation("ReturnProcessor")
  settingsUpdated      SystemSetting[]
  productsCreated      Product[]               @relation("ProductCreator")
  imagesUploaded       ProductImage[]

  @@index([role])
  @@index([status])
}

model Session {
  sid    String   @id
  sess   Json
  expire DateTime

  @@index([expire])
  @@map("session")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Customer {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  companyName  String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  country      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Permission {
  key         String @id
  description String
  category    String

  rolePermissions RolePermission[]
  userOverrides   UserPermissionOverride[]
}

model RolePermission {
  role          Role
  permissionKey String

  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([role, permissionKey])
  @@index([permissionKey])
}

model UserPermissionOverride {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @db.Uuid
  permissionKey String
  effect        PermissionEffect
  createdAt     DateTime         @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@unique([userId, permissionKey])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String?
  parentId    String?   @db.Uuid
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Product {
  id            String    @id @default(uuid()) @db.Uuid
  sku           String    @unique
  barcode       String?   @unique
  name          String
  description   String?
  categoryId    String?   @db.Uuid
  unitOfMeasure String    @default("unit")
  costPrice     Decimal   @default(0) @db.Decimal(14, 2)
  sellingPrice  Decimal   @default(0) @db.Decimal(14, 2)
  reorderLevel  Decimal   @default(0) @db.Decimal(14, 3)
  isActive      Boolean   @default(true)
  archivedAt    DateTime?
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy  User?     @relation("ProductCreator", fields: [createdById], references: [id], onDelete: SetNull)

  images           ProductImage[]
  balances         InventoryBalance[]
  movements        StockMovement[]
  supplierProducts SupplierProduct[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  orderItems         CustomerOrderItem[]
  reservations       StockReservation[]
  adjustments        StockAdjustment[]
  transferItems      StockTransferItem[]
  returnItems        ReturnItem[]

  @@index([categoryId])
  @@index([isActive])
  @@index([name])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  url       String
  altText   String?
  isPrimary Boolean  @default(false)
  uploadedById String? @db.Uuid
  createdAt DateTime @default(now())

  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Warehouses and inventory
// ---------------------------------------------------------------------------

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations      WarehouseLocation[]
  assignments    UserWarehouseAssignment[]
  balances       InventoryBalance[]
  movements      StockMovement[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  orders         CustomerOrder[]
  reservations   StockReservation[]
  adjustments    StockAdjustment[]
  transfersOut   StockTransfer[] @relation("TransferFrom")
  transfersIn    StockTransfer[] @relation("TransferTo")

  @@index([isActive])
}

model WarehouseLocation {
  id          String   @id @default(uuid()) @db.Uuid
  warehouseId String   @db.Uuid
  code        String
  name        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, code])
}

model UserWarehouseAssignment {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  warehouseId String   @db.Uuid
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([userId, warehouseId])
  @@index([warehouseId])
}

model InventoryBalance {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid
  warehouseId String   @db.Uuid
  onHand      Decimal  @default(0) @db.Decimal(14, 3)
  reserved    Decimal  @default(0) @db.Decimal(14, 3)
  avgCost     Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt   DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@index([productId])
}

model StockMovement {
  id            String       @id @default(uuid()) @db.Uuid
  productId     String       @db.Uuid
  warehouseId   String       @db.Uuid
  type          MovementType
  quantity      Decimal      @db.Decimal(14, 3)
  unitCost      Decimal      @db.Decimal(14, 2)
  balanceAfter  Decimal      @db.Decimal(14, 3)
  referenceType String?
  referenceId   String?
  reason        String?
  actorId       String?      @db.Uuid
  createdAt     DateTime     @default(now())

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Procurement
// ---------------------------------------------------------------------------

model Supplier {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products      SupplierProduct[]
  purchaseOrders PurchaseOrder[]

  @@index([isActive])
}

model SupplierProduct {
  id           String   @id @default(uuid()) @db.Uuid
  supplierId   String   @db.Uuid
  productId    String   @db.Uuid
  supplierSku  String?
  unitCost     Decimal  @db.Decimal(14, 2)
  leadTimeDays Int?
  createdAt    DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([supplierId, productId])
  @@index([productId])
}

model PurchaseOrder {
  id              String              @id @default(uuid()) @db.Uuid
  poNumber        String              @unique
  supplierId      String              @db.Uuid
  warehouseId     String              @db.Uuid
  status          PurchaseOrderStatus @default(DRAFT)
  subtotal        Decimal             @default(0) @db.Decimal(14, 2)
  taxTotal        Decimal             @default(0) @db.Decimal(14, 2)
  total           Decimal             @default(0) @db.Decimal(14, 2)
  approvalRequired Boolean            @default(false)
  notes           String?
  expectedAt      DateTime?
  createdById     String              @db.Uuid
  approvedById    String?             @db.Uuid
  approvedAt      DateTime?
  submittedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  supplier    Supplier   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy   User       @relation("PurchaseOrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy  User?      @relation("PurchaseOrderApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  items    PurchaseOrderItem[]
  receipts GoodsReceipt[]

  @@index([supplierId])
  @@index([warehouseId])
  @@index([status])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @db.Uuid
  productId       String  @db.Uuid
  quantity        Decimal @db.Decimal(14, 3)
  receivedQty     Decimal @default(0) @db.Decimal(14, 3)
  unitCost        Decimal @db.Decimal(14, 2)
  taxRate         Decimal @default(0) @db.Decimal(5, 2)
  lineTotal       Decimal @db.Decimal(14, 2)

  purchaseOrder PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  receiptItems  GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([productId])
}

model GoodsReceipt {
  id              String              @id @default(uuid()) @db.Uuid
  receiptNumber   String              @unique
  purchaseOrderId String              @db.Uuid
  warehouseId     String              @db.Uuid
  status          GoodsReceiptStatus  @default(CONFIRMED)
  notes           String?
  receivedById    String              @db.Uuid
  receivedAt      DateTime            @default(now())

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  receivedBy    User               @relation(fields: [receivedById], references: [id], onDelete: Restrict)
  items         GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([warehouseId])
}

model GoodsReceiptItem {
  id                String  @id @default(uuid()) @db.Uuid
  goodsReceiptId    String  @db.Uuid
  purchaseOrderItemId String @db.Uuid
  productId         String  @db.Uuid
  quantity          Decimal @db.Decimal(14, 3)
  unitCost          Decimal @db.Decimal(14, 2)

  goodsReceipt    GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  product         Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Sales
// ---------------------------------------------------------------------------

model CustomerOrder {
  id                   String              @id @default(uuid()) @db.Uuid
  orderNumber          String              @unique
  customerId           String              @db.Uuid
  status               CustomerOrderStatus @default(PENDING)
  warehouseId          String?             @db.Uuid
  subtotal             Decimal             @default(0) @db.Decimal(14, 2)
  taxTotal             Decimal             @default(0) @db.Decimal(14, 2)
  total                Decimal             @default(0) @db.Decimal(14, 2)
  currencyCode         String              @default("USD")
  paymentStatus        PaymentStatus       @default(PENDING)
  paymentMethod        String?
  paymentReference     String?
  paidAt               DateTime?
  shippingName         String
  shippingPhone        String?
  shippingAddress      String
  notes                String?
  cancelReason         String?
  placedAt             DateTime            @default(now())
  confirmedAt          DateTime?
  processingAt         DateTime?
  readyForDispatchAt   DateTime?
  dispatchedAt         DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  processedById        String?             @db.Uuid
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  customer    User      @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  processedBy User?     @relation("ProcessedOrders", fields: [processedById], references: [id], onDelete: SetNull)
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  items        CustomerOrderItem[]
  reservations StockReservation[]
  returns      Return[]

  @@index([customerId, createdAt])
  @@index([status])
  @@index([warehouseId])
  @@index([placedAt])
}

model CustomerOrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @db.Uuid
  productId      String  @db.Uuid
  productName    String
  sku            String
  quantity       Decimal @db.Decimal(14, 3)
  unitPrice      Decimal @db.Decimal(14, 2)
  taxRate        Decimal @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal @default(0) @db.Decimal(14, 2)
  lineTotal      Decimal @db.Decimal(14, 2)

  order   CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  returnItems ReturnItem[]

  @@index([orderId])
  @@index([productId])
}

model StockReservation {
  id          String            @id @default(uuid()) @db.Uuid
  orderId     String            @db.Uuid
  productId   String            @db.Uuid
  warehouseId String            @db.Uuid
  quantity    Decimal           @db.Decimal(14, 3)
  status      ReservationStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  releasedAt  DateTime?
  consumedAt  DateTime?

  order     CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId, warehouseId])
  @@index([orderId])
  @@index([status])
}

model Return {
  id           String       @id @default(uuid()) @db.Uuid
  returnNumber String       @unique
  orderId      String       @db.Uuid
  customerId   String       @db.Uuid
  status       ReturnStatus @default(REQUESTED)
  reason       String
  refundAmount Decimal      @default(0) @db.Decimal(14, 2)
  notes        String?
  processedById String?     @db.Uuid
  requestedAt  DateTime     @default(now())
  approvedAt   DateTime?
  receivedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  order       CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer    User          @relation("ReturnRequester", fields: [customerId], references: [id], onDelete: Restrict)
  processedBy User?         @relation("ReturnProcessor", fields: [processedById], references: [id], onDelete: SetNull)

  items ReturnItem[]

  @@index([orderId])
  @@index([customerId])
  @@index([status])
}

model ReturnItem {
  id          String  @id @default(uuid()) @db.Uuid
  returnId    String  @db.Uuid
  orderItemId String  @db.Uuid
  productId   String  @db.Uuid
  quantity    Decimal @db.Decimal(14, 3)
  unitPrice   Decimal @db.Decimal(14, 2)
  restock     Boolean @default(true)

  return    Return            @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem CustomerOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  product   Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Adjustments, transfers, audit, notifications, settings
// ---------------------------------------------------------------------------

model StockAdjustment {
  id               String           @id @default(uuid()) @db.Uuid
  adjustmentNumber String           @unique
  productId        String           @db.Uuid
  warehouseId      String           @db.Uuid
  kind             AdjustmentKind
  quantity         Decimal          @db.Decimal(14, 3)
  unitCost         Decimal?         @db.Decimal(14, 2)
  reason           String
  status           AdjustmentStatus @default(PENDING)
  requestedById    String           @db.Uuid
  approvedById     String?          @db.Uuid
  approvedAt       DateTime?
  appliedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  requestedBy User      @relation("AdjustmentRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  User?     @relation("AdjustmentApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([warehouseId])
  @@index([productId])
}

model StockTransfer {
  id             String         @id @default(uuid()) @db.Uuid
  transferNumber String         @unique
  fromWarehouseId String        @db.Uuid
  toWarehouseId   String        @db.Uuid
  status         TransferStatus @default(PENDING)
  notes          String?
  requestedById  String         @db.Uuid
  approvedById   String?        @db.Uuid
  approvedAt     DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  fromWarehouse Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  requestedBy   User      @relation("TransferRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy    User?     @relation("TransferApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  items StockTransferItem[]

  @@index([status])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
}

model StockTransferItem {
  id             String  @id @default(uuid()) @db.Uuid
  transferId     String  @db.Uuid
  productId      String  @db.Uuid
  quantity       Decimal @db.Decimal(14, 3)
  unitCost       Decimal @default(0) @db.Decimal(14, 2)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([transferId])
  @@index([productId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model SystemSetting {
  id                    Int      @id @default(1)
  companyName           String   @default("Inventory Management System")
  currencyCode          String   @default("USD")
  allowNegativeStock    Boolean  @default(false)
  purchaseApprovalLimit Decimal  @default(1000) @db.Decimal(14, 2)
  taxEnabled            Boolean  @default(false)
  defaultTaxRate        Decimal  @default(0) @db.Decimal(5, 2)
  lowStockNotifications Boolean  @default(true)
  updatedById           String?  @db.Uuid
  updatedAt             DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}
